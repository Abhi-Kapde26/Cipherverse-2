# Operation Janus Environment Variables (Placeholders only)

# Event Passcode required by participants during team registration
EVENT_PASSCODE=your_event_passcode_here

# High Command Master Administrator Key
ADMIN_KEY=your_admin_key_here
ADMIN_PASSWORD=your_admin_password_here

# Session Encryption Secret
SESSION_SECRET=your_session_secret_here

# Supabase Production Database Configuration
# Normalize URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# (Optional) Supabase Public Anonymous Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
